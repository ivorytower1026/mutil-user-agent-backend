# ============================================
# Multi-tenant AI Agent Platform 配置文件
# ============================================
# 说明：
# 1. 复制此文件为 .env
# 2. 修改必需配置项（标记为"必填"的项）
# 3. 可选配置项已有默认值，按需修改
# ============================================

# ============================================
# 必需配置项（必须修改）
# ============================================

# 智谱AI API密钥（必填）
ZHIPUAI_API_KEY=xxxx

# 数据库连接字符串（必填）
DATABASE_URL=postgresql://root:123456@localhost/agent_db

# JWT密钥（必填，生产环境请修改为随机字符串）
SECRET_KEY=your-secret-key-change-in-production

# ============================================
# Langfuse监控配置（IS_LANGFUSE=1时必填）
# ============================================
# 是否启用Langfuse监控 (1=开启, 0=关闭)
IS_LANGFUSE=1

# Langfuse密钥（IS_LANGFUSE=1时必填）
LANGFUSE_SECRET_KEY=sk-lf-b05a420a-746c-403e-97ef-9043ae69cd0d
LANGFUSE_PUBLIC_KEY=pk-lf-f4cc210d-afa4-4e1d-b9dd-0ccf7d9b4aaf
LANGFUSE_BASE_URL=http://192.168.11.33:3000

# ============================================
# 可选配置项（已有默认值，按需修改）
# ============================================

# 智谱AI API地址
# ZHIPUAI_API_BASE=https://open.bigmodel.cn/api/coding/paas/v4

# 工作空间目录配置
# WORKSPACE_ROOT=/.mutil-user-agent/workspace
# SHARED_DIR=/.mutil-user-agent/shared
# SKILL_DIR=/.mutil-user-agent/skills
# SKILL_DISABLE_DIR=/.mutil-user-agent/skills_disable

# Docker配置
# DOCKER_IMAGE=mutil-user-agent-sandbox:latest
# CONTAINER_WORKSPACE_DIR=/workspace
# CONTAINER_SHARED_DIR=/shared
# CONTAINER_SKILLS_DIR=/skills
# CPU核数限制
# DOCKER_CPU_LIMIT=1.0
# 内存限制
# DOCKER_MEMORY_LIMIT=2g
# 空闲超时时间（秒）
# DOCKER_IDLE_TIMEOUT_SECONDS=300

# 服务端口和JWT过期时间
# PORT=8009
# ACCESS_TOKEN_EXPIRE_HOURS=24

# Redis配置
# REDIS_URL=redis://localhost:6379/0

# LLM模式（1=智谱AI，2=本地VLLM）
# LLM_MODE=1

# ModelScope配置（LLM_MODE=1时使用）
# MODELSCOPE_URL=https://api-inference.modelscope.cn/v1
# MODELSCOPE_SDK_TOKEN=

# OpenAI兼容API配置（LLM_MODE=2时使用）
# OPENAI_API_BASE_8001=http://192.168.110.44:8001/v1
# OPENAI_API_BASE_8002=http://192.168.110.44:8002/v1

# Flash模型配置
# FLASH_MODEL_NAME=Qwen3.5-35B-A3B
# FLASH_MODEL_URL=http://192.168.110.44:8001/v1

# Memory记忆系统配置
# 是否启用记忆功能 (1=开启, 0=关闭)
# MEMORY_ENABLED=1
# Qdrant向量数据库配置
# MEM0_QDRANT_HOST=localhost
# MEM0_QDRANT_PORT=6333
# MEM0_COLLECTION_NAME=multi_agent_memory

# Skill镜像存储配置
# SKILL_IMAGES_DIR=D:\docker_volume\mutil-user-agent\skill-images
# SKILL_IMAGE_VERSIONS_TO_KEEP=5

# ============================================
# 配置说明
# ============================================
# 
# 快速开始：
# 1. 复制此文件为 .env
# 2. 修改 ZHIPUAI_API_KEY 为你的智谱AI密钥
# 3. 修改 DATABASE_URL 为你的数据库连接字符串
# 4. 修改 SECRET_KEY 为随机字符串（生产环境必须）
# 5. 如需启用Langfuse监控，配置Langfuse相关参数
# 6. 运行: uv run python main.py
#
# LLM_MODE 说明：
# - LLM_MODE=1: 使用智谱AI + ModelScope
# - LLM_MODE=2: 使用本地VLLM服务
#
# 目录说明：
# - WORKSPACE_ROOT: 用户工作空间根目录
# - SHARED_DIR: 共享资源目录
# - SKILL_DIR: 技能目录
# - SKILL_DISABLE_DIR: 禁用技能目录
# - SKILL_IMAGES_DIR: 技能Docker镜像存储目录
#
# Docker资源限制：
# - DOCKER_CPU_LIMIT: 每个容器的CPU核数限制
# - DOCKER_MEMORY_LIMIT: 每个容器的内存限制
# - DOCKER_IDLE_TIMEOUT_SECONDS: 容器空闲超时自动清理时间
#
# ============================================
