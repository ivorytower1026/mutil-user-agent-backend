# 智谱AI配置
ZHIPUAI_API_KEY=xxxx
ZHIPUAI_API_BASE=https://open.bigmodel.cn/api/coding/paas/v4

# 工作空间根目录（支持相对路径和绝对路径）
# Windows示例: C:\workspaces 或 ./workspaces
# Linux示例:   /home/user/workspaces 或 ./workspaces
WORKSPACE_ROOT=D:\docker_volume\mutil-user-agent\workspace

# 共享目录（只读挂载）
# Windows示例: C:\shared 或 ./shared
# Linux示例:   /opt/shared 或 ./shared
SHARED_DIR=D:\docker_volume\mutil-user-agent\shared
SKILL_DIR=D:\docker_volume\mutil-user-agent\skills
SKILL_DISABLE_DIR=D:\docker_volume\mutil-user-agent\skills_disable

# Docker镜像
DOCKER_IMAGE=e2bdev/code-interpreter

# 容器内的工作目录
CONTAINER_WORKSPACE_DIR=/workspace
CONTAINER_SHARED_DIR=/shared
CONTAINER_SKILLS_DIR=/skills


# 可选：如果使用其他OpenAI兼容的API，修改以下配置
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_API_BASE=https://api.openai.com/v1/

IS_LANGFUSE=1
LANGFUSE_SECRET_KEY=sk-lf-b05a420a-746c-403e-97ef-9043ae69cd0d
LANGFUSE_PUBLIC_KEY=pk-lf-f4cc210d-afa4-4e1d-b9dd-0ccf7d9b4aaf
LANGFUSE_BASE_URL=http://192.168.11.33:3000

DATABASE_URL="postgresql://root:123456@localhost/agent_db"
OPENAI_API_BASE_8001="http://192.168.110.44:8001/v1"
OPENAI_API_BASE_8002="http://192.168.110.44:8002/v1"

# JWT配置
SECRET_KEY="your-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_HOURS=24

# 服务端口
PORT=8005

MODELSCOPE_URL=https://api-inference.modelscope.cn/v1
MODELSCOPE_SDK_TOKEN=



# Docker 资源限制
# CPU 核数
DOCKER_CPU_LIMIT=1.0
# 内存限制
DOCKER_MEMORY_LIMIT=2g

# 沙箱超时配置
# 10 分钟无操作自动清理
DOCKER_IDLE_TIMEOUT_SECONDS=30
REDIS_URL=redis://localhost:6379/0

LLM_MODE=2

# Mem0 记忆系统配置
MEMORY_ENABLED=1  # 是否启用记忆功能 (1=开启, 0=关闭)
MEM0_COLLECTION_NAME=multi_agent_memory
MEM0_QDRANT_HOST=192.168.11.16
MEM0_QDRANT_PORT=6333