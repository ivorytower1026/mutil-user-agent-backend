# ============================================
# Docker 环境变量配置 (Linux/Mac)
# ============================================
# 用于 docker-compose.yml 中的环境变量
# 使用方式: 复制为 .env.docker 并按需修改
# ============================================

# ============================================
# 数据目录配置
# ============================================

# Redis 数据目录
REDIS_DATA_DIR=/var/lib/mutil-user-agent/redis/data
REDIS_CONF_DIR=/var/lib/mutil-user-agent/redis/redis.conf

# PostgreSQL 数据目录
POSTGRES_DATA_DIR=/var/lib/mutil-user-agent/postgres/data

# Qdrant 向量数据库数据目录
QDRANT_DATA_DIR=/var/lib/mutil-user-agent/qdrant/data

# ============================================
# 代理配置（可选）
# ============================================
# 如果需要使用代理，取消注释以下行
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ============================================
# PostgreSQL 配置
# ============================================
POSTGRES_PASSWORD=123456
POSTGRES_USER=root
POSTGRES_DB=agent_db

# ============================================
# 使用说明
# ============================================
# 
# 1. 数据目录权限:
#    sudo mkdir -p /var/lib/mutil-user-agent/{redis,postgres,qdrant}/data
#    sudo chown -R $USER:$USER /var/lib/mutil-user-agent
#
# 2. Redis 配置文件（可选）:
#    如果需要自定义 Redis 配置，创建配置文件:
#    sudo mkdir -p /var/lib/mutil-user-agent/redis
#    sudo touch /var/lib/mutil-user-agent/redis/redis.conf
#
# 3. 启动 Docker 容器:
#    docker-compose --env-file .env.docker up -d
#
# 4. 查看日志:
#    docker-compose logs -f
#
# 5. 停止容器:
#    docker-compose down
#
# ============================================
