# ============================================
# Docker 环境变量配置 (Windows)
# ============================================
# 用于 docker-compose.yml 中的环境变量
# 使用方式: 复制为 .env.docker 并按需修改
# ============================================

# ============================================
# 数据目录配置
# ============================================
# Windows 路径格式说明：
# - 使用正斜杠 / （推荐）: D:/docker_volume/redis/data
# - 使用双反斜杠 \\: D:\\docker_volume\\redis\\data
# - Docker Desktop 会自动处理路径转换

# Redis 数据目录
REDIS_DATA_DIR=D:/docker_volume/mutil-user-agent/redis/data
REDIS_CONF_DIR=D:/docker_volume/mutil-user-agent/redis/redis.conf

# PostgreSQL 数据目录
POSTGRES_DATA_DIR=D:/docker_volume/mutil-user-agent/postgres/data

# Qdrant 向量数据库数据目录
QDRANT_DATA_DIR=D:/docker_volume/mutil-user-agent/qdrant/data

# ============================================
# 代理配置（可选）
# ============================================
# 如果需要使用代理，取消注释以下行
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ============================================
# PostgreSQL 配置
# ============================================
POSTGRES_PASSWORD=123456
POSTGRES_USER=root
POSTGRES_DB=agent_db

# ============================================
# 使用说明 (Windows)
# ============================================
# 
# 1. Docker Desktop 要求：
#    - 确保已安装并启动 Docker Desktop
#    - 建议使用 WSL 2 后端（Settings > General > Use WSL 2 based engine）
#    - 确保共享了相关驱动器（Settings > Resources > File Sharing）
#
# 2. 创建数据目录：
#    方法1 - 使用 PowerShell:
#      New-Item -ItemType Directory -Force -Path "D:\docker_volume\mutil-user-agent\redis\data"
#      New-Item -ItemType Directory -Force -Path "D:\docker_volume\mutil-user-agent\postgres\data"
#      New-Item -ItemType Directory -Force -Path "D:\docker_volume\mutil-user-agent\qdrant\data"
#
#    方法2 - 使用命令提示符:
#      mkdir D:\docker_volume\mutil-user-agent\redis\data
#      mkdir D:\docker_volume\mutil-user-agent\postgres\data
#      mkdir D:\docker_volume\mutil-user-agent\qdrant\data
#
# 3. Redis 配置文件（可选）:
#    如果需要自定义 Redis 配置，创建配置文件:
#    New-Item -ItemType File -Force -Path "D:\docker_volume\mutil-user-agent\redis\redis.conf"
#
# 4. 启动 Docker 容器:
#    docker-compose --env-file .env.docker up -d
#
# 5. 查看日志:
#    docker-compose logs -f
#
# 6. 停止容器:
#    docker-compose down
#
# 7. 数据持久化说明：
#    - 数据会保存在宿主机的 D:\docker_volume\mutil-user-agent\ 目录
#    - 即使删除容器，数据也不会丢失
#    - 如需重置，手动删除对应的 data 目录即可
#
# ============================================
